#compdef check-now
# check-now completion
_check-now() {
  local -a commands shells plugins flags
  commands=(shell refresh dismiss list doctor plugin completion)
  shells=(bash zsh fish powershell pwsh)
  plugins=(node bun deno fnm codex claude)
  flags=(--force --background --id --name --description --tool --source-url --runtime --manager --capability --non-interactive)
  if (( CURRENT == 2 )); then _describe 'command' commands; return; fi
  case $words[2] in
    completion) (( CURRENT == 3 )) && _describe 'shell' shells ;;
    refresh) _arguments '--force[force refresh]' '--background[refresh in background]' ;;
    dismiss) (( CURRENT == 3 )) && _describe 'plugin' plugins ;;
    plugin)
      if [[ $words[3] == create ]]; then
        _arguments '1:plugin id:' $flags '--runtime=[runtime]:runtime:(shell)' '--capability=[capabilities]:capability:(current refresh)'
      fi ;;
  esac
}
compdef _check-now check-now
